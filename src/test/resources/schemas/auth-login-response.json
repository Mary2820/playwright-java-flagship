{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["accessToken", "refreshToken", "id", "username", "email"],
  "properties": {
    "accessToken": {"type": "string", "minLength": 1},
    "refreshToken": {"type": "string", "minLength": 1},
    "id": {"type": "integer"},
    "username": {"type": "string"},
    "email": {"type": "string"}
  }
}
