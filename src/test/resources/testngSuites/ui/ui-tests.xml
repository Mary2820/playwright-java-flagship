<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="ui">
    <test name="Open site">
        <classes>
            <class name="io.github.mary2820.tests.ui.HomePageTest">
                <methods>
                    <include name="openSiteTest"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Home page has no ads">
        <classes>
            <class name="io.github.mary2820.tests.ui.AdBlockerTest">
                <methods>
                    <include name="homePageHasNoAdsTest"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Ad URLs are recognised">
        <classes>
            <class name="io.github.mary2820.tests.ui.AdBlockerTest">
                <methods>
                    <include name="isAdTest"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Login with valid credentials">
        <classes>
            <class name="io.github.mary2820.tests.ui.LoginTest">
                <methods>
                    <include name="userCanLoginWithValidCredentialsTest"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Login with wrong password">
        <classes>
            <class name="io.github.mary2820.tests.ui.LoginTest">
                <methods>
                    <include name="loginFailsWithWrongPasswordTest"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Search returns matching products">
        <classes>
            <class name="io.github.mary2820.tests.ui.ProductsTest">
                <methods>
                    <include name="searchReturnsOnlyMatchingProductsTest"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Added product appears in cart">
        <classes>
            <class name="io.github.mary2820.tests.ui.CartTest">
                <methods>
                    <include name="addedProductAppearsInCartWithCatalogPriceAndQuantityOneTest"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
