<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="header">
    <test name="Guest header shows all items">
        <classes>
            <class name="io.github.mary2820.tests.ui.HeaderTest">
                <methods>
                    <include name="guestHeaderShowsAllItemsTest"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Internal links lead to their pages">
        <classes>
            <class name="io.github.mary2820.tests.ui.HeaderTest">
                <methods>
                    <include name="internalLinksLeadToTheirPagesTest"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Header of an authenticated user">
        <classes>
            <class name="io.github.mary2820.tests.ui.HeaderTest">
                <methods>
                    <include name="authenticatedHeaderShowsUserAndAccountItemsTest"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Logout from the header">
        <classes>
            <class name="io.github.mary2820.tests.ui.HeaderTest">
                <methods>
                    <include name="logoutReturnsToLoginAndShowsGuestHeaderTest"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
