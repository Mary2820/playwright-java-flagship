<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="technical">
    <test name="Home page has no ads">
        <classes>
            <class name="io.github.mary2820.tests.ui.AdBlockerTest">
                <methods>
                    <include name="homePageHasNoAdsTest"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Ad URLs are recognised">
        <classes>
            <class name="io.github.mary2820.tests.ui.AdHostsTest">
                <methods>
                    <include name="isAdTest"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="JSON Schemas accept a valid response">
        <classes>
            <class name="io.github.mary2820.tests.api.JsonSchemaTest">
                <methods>
                    <include name="validResponseIsAcceptedTest"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="JSON Schemas reject a broken response">
        <classes>
            <class name="io.github.mary2820.tests.api.JsonSchemaTest">
                <methods>
                    <include name="brokenResponseIsRejectedTest"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
