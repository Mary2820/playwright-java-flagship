<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="api">
    <test name="User lifecycle">
        <classes>
            <class name="io.github.mary2820.tests.api.UserApiTest">
                <methods>
                    <include name="userLifecycleTest"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Duplicate email is rejected">
        <classes>
            <class name="io.github.mary2820.tests.api.UserApiTest">
                <methods>
                    <include name="duplicateEmailIsRejectedTest"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Wrong password is rejected">
        <classes>
            <class name="io.github.mary2820.tests.api.UserApiTest">
                <methods>
                    <include name="wrongPasswordIsRejectedTest"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Products list">
        <classes>
            <class name="io.github.mary2820.tests.api.CatalogApiTest">
                <methods>
                    <include name="productsListReturnsProductsTest"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Brands list">
        <classes>
            <class name="io.github.mary2820.tests.api.CatalogApiTest">
                <methods>
                    <include name="brandsListReturnsBrandsTest"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="User detail returns the user">
        <classes>
            <class name="io.github.mary2820.tests.api.UserDetailApiTest">
                <methods>
                    <include name="userDetailReturnsUserTest"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="User detail without email is rejected">
        <classes>
            <class name="io.github.mary2820.tests.api.UserDetailApiTest">
                <methods>
                    <include name="userDetailWithoutEmailIsRejectedTest"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="User detail for an unknown email">
        <classes>
            <class name="io.github.mary2820.tests.api.UserDetailApiTest">
                <methods>
                    <include name="userDetailForUnknownEmailIsNotFoundTest"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Search returns matching products">
        <classes>
            <class name="io.github.mary2820.tests.api.SearchApiTest">
                <methods>
                    <include name="searchReturnsMatchingProductsTest"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Search with no matches">
        <classes>
            <class name="io.github.mary2820.tests.api.SearchApiTest">
                <methods>
                    <include name="searchWithNoMatchesReturnsEmptyListTest"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Search without parameter is rejected">
        <classes>
            <class name="io.github.mary2820.tests.api.SearchApiTest">
                <methods>
                    <include name="searchWithoutParameterIsRejectedTest"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Create account without a required parameter">
        <classes>
            <class name="io.github.mary2820.tests.api.UserCrudApiTest">
                <methods>
                    <include name="createAccountWithoutRequiredParameterIsRejectedTest"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Update account">
        <classes>
            <class name="io.github.mary2820.tests.api.UserCrudApiTest">
                <methods>
                    <include name="updateAccountChangesUserDataTest"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Update account for an unknown email">
        <classes>
            <class name="io.github.mary2820.tests.api.UserCrudApiTest">
                <methods>
                    <include name="updateAccountForUnknownEmailIsNotFoundTest"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Update account with a wrong password">
        <classes>
            <class name="io.github.mary2820.tests.api.UserCrudApiTest">
                <methods>
                    <include name="updateAccountWithWrongPasswordDoesNotChangeUserTest"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Delete account for an unknown account">
        <classes>
            <class name="io.github.mary2820.tests.api.UserCrudApiTest">
                <methods>
                    <include name="deleteAccountForUnknownAccountIsNotFoundTest"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Delete account with a wrong password">
        <classes>
            <class name="io.github.mary2820.tests.api.UserCrudApiTest">
                <methods>
                    <include name="deleteAccountWithWrongPasswordDoesNotDeleteAccountTest"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Verify login without email">
        <classes>
            <class name="io.github.mary2820.tests.api.VerifyLoginApiTest">
                <methods>
                    <include name="verifyLoginWithoutEmailIsRejectedTest"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Verify login without password">
        <classes>
            <class name="io.github.mary2820.tests.api.VerifyLoginApiTest">
                <methods>
                    <include name="verifyLoginWithoutPasswordIsRejectedTest"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Verify login with DELETE">
        <classes>
            <class name="io.github.mary2820.tests.api.VerifyLoginApiTest">
                <methods>
                    <include name="verifyLoginWithDeleteIsNotSupportedTest"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Verify login with an unregistered email">
        <classes>
            <class name="io.github.mary2820.tests.api.VerifyLoginApiTest">
                <methods>
                    <include name="verifyLoginWithUnregisteredEmailIsNotFoundTest"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Wrong method returns a real HTTP 405">
        <classes>
            <class name="io.github.mary2820.tests.api.WrongMethodApiTest">
                <methods>
                    <include name="wrongMethodReturnsRealHttp405Test"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Auth login returns tokens">
        <classes>
            <class name="io.github.mary2820.tests.api.AuthTokenApiTest">
                <methods>
                    <include name="loginReturnsTokensTest"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Auth me with a Bearer token">
        <classes>
            <class name="io.github.mary2820.tests.api.AuthTokenApiTest">
                <methods>
                    <include name="meWithBearerTokenReturnsUserTest"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Auth me without a token">
        <classes>
            <class name="io.github.mary2820.tests.api.AuthTokenApiTest">
                <methods>
                    <include name="meWithoutTokenIsRejectedTest"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Auth login with a wrong password">
        <classes>
            <class name="io.github.mary2820.tests.api.AuthTokenApiTest">
                <methods>
                    <include name="loginWithWrongPasswordIsRejectedTest"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Auth login without credentials">
        <classes>
            <class name="io.github.mary2820.tests.api.AuthTokenApiTest">
                <methods>
                    <include name="loginWithoutCredentialsIsRejectedTest"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="JSON Schemas accept a valid response">
        <classes>
            <class name="io.github.mary2820.tests.api.JsonSchemaTest">
                <methods>
                    <include name="validResponseIsAcceptedTest"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="JSON Schemas reject a broken response">
        <classes>
            <class name="io.github.mary2820.tests.api.JsonSchemaTest">
                <methods>
                    <include name="brokenResponseIsRejectedTest"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
